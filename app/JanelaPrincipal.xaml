<Window x:Class="QubitsCast.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QubitsCast" Height="720" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fundo}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Fundo}" BorderBrush="{StaticResource Borda}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== barra de título ==================== -->
            <Grid Grid.Row="0" Height="42" Background="{StaticResource Painel}"
                  MouseLeftButtonDown="BarraTitulo_Arrastar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Canvas Width="18" Height="18" Margin="0,0,9,0">
                        <Path Data="M1,3 L17,3 L17,14 L1,14 Z" Stroke="{StaticResource Acento}"
                              StrokeThickness="1.6" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="7" Canvas.Top="6.5" Width="4" Height="4"
                                 Fill="{StaticResource Acento}"/>
                    </Canvas>
                    <TextBlock Text="QubitsCast" FontWeight="SemiBold" FontSize="{StaticResource TipoPequeno}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TituloBarra" Grid.Column="1" Text="" Style="{StaticResource Legenda}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BotaoDiscreto}" Click="Janela_Minimizar"
                            Padding="16,10" ToolTip="Minimizar">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource Suave}" StrokeThickness="1.4"/>
                    </Button>
                    <Button Style="{StaticResource BotaoDiscreto}" Click="Janela_Maximizar"
                            Padding="16,10" ToolTip="Maximizar">
                        <Path Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="{StaticResource Suave}"
                              StrokeThickness="1.4"/>
                    </Button>
                    <Button x:Name="BotaoFechar" Style="{StaticResource BotaoDiscreto}" Click="Janela_Fechar"
                            Padding="16,10" ToolTip="Fechar">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Suave}"
                              StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ==================== tela de entrada ==================== -->
            <Grid x:Name="PainelEntrada" Grid.Row="1">
                <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource Painel}" BorderBrush="{StaticResource Borda}"
                        BorderThickness="1" CornerRadius="{StaticResource RaioGrande}" Padding="32,30">
                    <StackPanel>
                        <TextBlock Text="Transmitir minha tela" Style="{StaticResource Titulo}"/>
                        <TextBlock Text="Crie uma sala e mande o link para quem vai assistir."
                                   Style="{StaticResource Legenda}" Margin="0,6,0,26" TextWrapping="Wrap"/>

                        <TextBlock Text="SEU NOME" Style="{StaticResource Legenda}" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{StaticResource Apagado}" Margin="0,0,0,7"/>
                        <TextBox x:Name="CampoApelido" MaxLength="20" Margin="0,0,0,20"/>

                        <Button x:Name="BotaoCriar" Style="{StaticResource BotaoPrimario}"
                                Content="Criar uma sala" Click="Criar_Clique" Padding="16,12"/>

                        <Grid Margin="0,20,0,20">
                            <Border Height="1" Background="{StaticResource Borda}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource Painel}" HorizontalAlignment="Center" Padding="12,0">
                                <TextBlock Text="ou entre em uma" Style="{StaticResource Legenda}"
                                           Foreground="{StaticResource Apagado}"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CampoCodigo" Grid.Column="0" MaxLength="12"
                                     FontFamily="{StaticResource FonteMono}" FontSize="16"
                                     CharacterCasing="Upper" KeyDown="CampoCodigo_Tecla"
                                     Margin="0,0,10,0"/>
                            <Button x:Name="BotaoEntrar" Grid.Column="1" Style="{StaticResource BotaoBase}"
                                    Content="Entrar" Click="Entrar_Clique" Padding="22,10"/>
                        </Grid>
                        <TextBlock Text="Cole aqui o código da sala, ou clique direto no link do convite."
                                   Style="{StaticResource Legenda}" Foreground="{StaticResource Apagado}"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <Border Margin="0,24,0,0" Padding="12,10" CornerRadius="{StaticResource RaioPequeno}"
                                Background="#11141A" BorderBrush="{StaticResource Borda}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LuzServidor" Width="8" Height="8"
                                         Fill="{StaticResource Apagado}" VerticalAlignment="Center"
                                         Margin="0,0,9,0"/>
                                <TextBlock x:Name="TextoServidor" Text="verificando o servidor…"
                                           Style="{StaticResource Legenda}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== sala ==================== -->
            <Grid x:Name="PainelSala" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="252"/>
                </Grid.ColumnDefinitions>

                <!-- cabeçalho da sala -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Painel}"
                        BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="NomeSala" Text="Sala" FontWeight="SemiBold"
                                       FontSize="{StaticResource TipoMedio}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="código" Style="{StaticResource Legenda}" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="CodigoSala" Text="——" Margin="6,0,0,0"
                                           FontFamily="{StaticResource FonteMono}" FontSize="13"
                                           Foreground="{StaticResource Acento}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BotaoCopiarLink" Style="{StaticResource BotaoBase}"
                                    Content="Copiar link do convite" Click="CopiarLink_Clique"
                                    Padding="14,9" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BotaoDiscreto}" Content="Sair da sala"
                                    Click="Sair_Clique" Padding="14,9"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- área de vídeo -->
                <Grid Grid.Row="1" Grid.Column="0" Background="#08090C">
                    <Image x:Name="Video" Stretch="Uniform" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="LowQuality"/>

                    <StackPanel x:Name="AvisoVazio" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Path Data="M4,8 L52,8 L52,40 L4,40 Z" Stroke="{StaticResource BordaViva}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                            <Path Data="M20,48 L36,48" Stroke="{StaticResource BordaViva}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="24" Canvas.Top="19" Width="8" Height="8"
                                     Fill="{StaticResource BordaViva}"/>
                        </Canvas>
                        <TextBlock x:Name="TextoVazio" Text="Ninguém está transmitindo ainda"
                                   Foreground="{StaticResource Suave}" FontSize="{StaticResource TipoMedio}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TextoVazio2"
                                   Text="Clique em “Transmitir minha tela” para começar."
                                   Style="{StaticResource Legenda}" Foreground="{StaticResource Apagado}"
                                   HorizontalAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>

                    <!-- selo de estatísticas sobre o vídeo -->
                    <Border x:Name="Selo" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="14" Padding="10,6" CornerRadius="{StaticResource RaioPequeno}"
                            Background="#CC0E1015" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TextoSelo" Text="" FontSize="12"
                                       Foreground="{StaticResource Suave}"
                                       FontFamily="{StaticResource FonteMono}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- participantes -->
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Painel}"
                        BorderBrush="{StaticResource Borda}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="TituloParticipantes" Text="NA SALA"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Apagado}"
                                   Margin="16,16,16,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListaParticipantes" Margin="8,0,8,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,9" CornerRadius="{StaticResource RaioPequeno}"
                                                Background="Transparent" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                        Background="{Binding Cor}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Inicial}" Foreground="White"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Nome}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           FontSize="{StaticResource TipoPequeno}"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Marca}" FontSize="11"
                                                               Foreground="{StaticResource Acento}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- barra de controles -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Painel}"
                        BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BotaoTransmitir" Grid.Column="0" Style="{StaticResource BotaoPrimario}"
                                Content="Transmitir minha tela" Click="Transmitir_Clique"
                                Padding="18,11" Margin="0,0,10,0"/>

                        <ComboBox x:Name="SeletorMonitor" Grid.Column="1" Width="188" Margin="0,0,8,0"
                                  ToolTip="Qual tela transmitir"/>

                        <ComboBox x:Name="SeletorQualidade" Grid.Column="2" Width="232"
                                  ToolTip="Resolução, quadros por segundo e quanto gasta de internet"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                            <TextBlock Text="Volume" Style="{StaticResource Legenda}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="ControleVolume" Width="94" Minimum="0" Maximum="100" Value="100"
                                    VerticalAlignment="Center" ValueChanged="Volume_Mudou"
                                    IsSnapToTickEnabled="True" TickFrequency="1"/>
                        </StackPanel>

                        <Button x:Name="BotaoMicrofone" Grid.Column="5" Style="{StaticResource BotaoBase}"
                                Content="Microfone desligado" Click="Microfone_Clique" Padding="14,10"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== aviso flutuante ==================== -->
            <Border x:Name="Aviso" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,18,0,0" Padding="16,11" CornerRadius="{StaticResource RaioPequeno}"
                    Background="{StaticResource PainelAlto}" BorderBrush="{StaticResource BordaViva}"
                    BorderThickness="1" Visibility="Collapsed" Panel.ZIndex="10">
                <TextBlock x:Name="TextoAviso" Text="" FontSize="{StaticResource TipoPequeno}"/>
            </Border>
        </Grid>
    </Border>
</Window>
